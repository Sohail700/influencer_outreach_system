# Required for discovery
YOUTUBE_API_KEY=

# Required for true LLM personalization (can be left blank while using --skip-llm)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Filtering
MIN_FOLLOWERS=5000
MAX_FOLLOWERS=100000
MIN_ENGAGEMENT_RATE=0.5
MIN_SCORE=60
DISCOVERY_TARGET=50
RECENT_VIDEO_COUNT=8

# Sending (only needed for real SMTP sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
